# The installer for one Bilibi instance: bilibi-installer@production,
# bilibi-installer@dev. It puts the releases a server owner asks for on the
# Software page into service, and takes them back. Installed by
# scripts/install-server.sh installer; what it does is in apps/installer/README.md.
[Unit]
Description=Bilibi installer for instance %i
Documentation=https://github.com/BelimbingProject/bilibi/blob/main/apps/installer/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# bilibi@ pulls this unit in: skip it quietly until the installer program is in place.
ConditionFileIsExecutable=/opt/bilibi/build/bin/bilibi-installer
# After a reboot in the middle of a job this starts first, so it can stop the
# instance again before the old program takes any entry.
Before=bilibi@%i.service

[Service]
Type=simple
# bilibi-build owns releases/ and backups/ and may start and stop bilibi@* through sudo.
User=bilibi-build
Group=bilibi-build
# DATABASE_URL (the instance's own database) and BIND_ADDR (where its program answers).
EnvironmentFile=/opt/bilibi/%i/env
WorkingDirectory=/opt/bilibi/build
ExecStart=/opt/bilibi/build/bin/bilibi-installer /opt/bilibi/%i
# A job cut off here is settled when the service is back: see "If the server restarts mid-way".
Restart=always
RestartSec=3
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
