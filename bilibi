#!/usr/bin/env bash
# Platform front door; no Bilimbi module counterpart. Application workspaces: ADR 03.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
cd "$root"
# shellcheck source=scripts/lib/prerequisites.sh
source "$root/scripts/lib/prerequisites.sh"
case ${1:-help} in
    start|setup|add)
        command=$1
        if [[ $command == add ]]; then
            [[ $# == 2 || $# == 8 ]] || { echo 'Usage: ./bilibi add <component> [--kind domains|extensions --source <url> --commit <sha>]' >&2; exit 1; }
        else
            [[ $# == 1 ]] || { echo "Usage: ./bilibi $command" >&2; exit 1; }
        fi
        activate_cargo
        if [[ $command == setup ]] || ! development_prerequisites; then
            bash "$root/scripts/setup.sh"
            # Setup runs in a child shell. Activate newly installed tools here too.
            activate_cargo
        fi
        development_prerequisites || { echo 'Prerequisites still fail. Run ./bilibi setup and check .local/setup.log.' >&2; exit 1; }
        if [[ $command == add ]]; then
            exec python3 "$root/scripts/platform.py" "$@"
        fi
        python3 "$root/scripts/install-platform-hook.py" --warn
        if [[ $command == start ]]; then
            python3 "$root/scripts/platform.py" status
            exec "$root/scripts/start-app.sh"
        fi
        ;;
    status|update)
        activate_cargo
        python3 -c 'import tomllib' 2>/dev/null || { echo 'Python 3.11+ is required. See README.md (supported environment).' >&2; exit 1; }
        if [[ $1 == update ]]; then
            [[ $# == 1 ]] || { echo 'Usage: ./bilibi update' >&2; exit 1; }
            exec python3 "$root/scripts/update-platform.py"
        fi
        exec python3 "$root/scripts/platform.py" "$@"
        ;;
    new)
        activate_cargo
        python3 -c 'import tomllib' 2>/dev/null || { echo 'Python 3.11+ is required. See README.md.' >&2; exit 1; }
        exec python3 "$root/scripts/new-application.py" "${@:2}"
        ;;
    check|build|release)
        echo "./bilibi $1 works in an application, not here."
        echo 'This is the Bilibi Platform: Bilibi'"'"'s own source code.'
        echo 'To make your own application from what you have here, run: ./bilibi new <name>'
        echo 'Or start one with the app maker: https://github.com/BelimbingApp/bilibi-app-maker'
        exit 1
        ;;
    help|--help|-h)
        cat <<'USAGE'
This is the Bilibi Platform: Bilibi's own source code.
Work here to change Bilibi itself, or to try Domains and Extensions.
To make a product of your own, start with the app maker:
https://github.com/BelimbingApp/bilibi-app-maker

Usage: ./bilibi <command>

Run Bilibi on this computer
  start         Install anything missing, run Bilibi, and open it in your browser.
  add <name>    Add a Domain or Extension, such as: ./bilibi add finance
                Or paste the add command that the Software page shows.
                Then run ./bilibi start again to use it.

Stay up to date
  update        Get the latest Bilibi changes, and move the Domains and
                Extensions you added to their newest recommended versions.
                A Domain or Extension from your own repository moves forward
                too, once you say you trust that repository.
  status        List Bilibi and what you added, with each one's branch and
                any changes you have not committed.

Less often
  setup         Install the tools only, without starting Bilibi.
  new <name>    Turn what you have here into your own application, in a new
                folder next to this one.
  help          Show this list.
USAGE
        ;;
    *) echo "Unknown command: $1. Run ./bilibi --help." >&2; exit 1 ;;
esac
